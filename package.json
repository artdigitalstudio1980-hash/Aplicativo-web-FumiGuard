{
  "name": "temp-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development nodemon --watch server.ts --watch routes --watch controllers --watch middlewares --watch services --exec ts-node --project tsconfig.server.json server.ts",
    "clean": "rm -rf .next dist",
    "build": "npm run clean && npx prisma generate && next build && tsc --project tsconfig.server.json",
    "build:deploy": "npm run clean && npx prisma generate && npx prisma db push && next build && tsc --project tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "next lint"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "autoprefixer": "^10.4.19",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.16.0",
    "morgan": "^1.10.1",
    "next": "14.2.35",
    "nodemailer": "^6.10.1",
    "postcss": "^8",
    "react": "^18",
    "react-dom": "^18",
    "stripe": "^22.1.1",
    "tailwindcss": "^3.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "nodemon": "^3.1.14",
    "prisma": "^5.13.0",
    "ts-node": "^10.9.2",
    "typescript": "^7"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts",
    "seed-admin": "ts-node prisma/seed-admin.ts"
  }
}
